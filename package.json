{
  "name": "@bioleyl/skills-repo",
  "version": "0.2.0",
  "description": "A lightweight registry and CLI for AI agent skills.",
  "type": "module",
  "bin": {
    "skills-repo": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p test/tsconfig.json",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "build:registry": "npm run build && node dist/scripts/buildRegistry.js",
    "build:site": "npm run build && node dist/scripts/buildSite.js",
    "validate": "npm run build && node dist/index.js validate",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "semver": "^7.7.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "^26.4.1",
    "@types/semver": "^7.7.0",
    "dependency-cruiser": "^18.2.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bioleyl/skills-repo.git"
  },
  "homepage": "https://github.com/bioleyl/skills-repo",
  "bugs": {
    "url": "https://github.com/bioleyl/skills-repo/issues"
  }
}
